{
  "expo": {
    "name": "ArkIve",
    "slug": "arkive",
    "version": "1.0.0",
    "scheme": "arkive",
    "orientation": "portrait",
    "icon": "./src/assets/branding/definitive-square.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arkive.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/branding/definitive-square.png",
        "backgroundColor": "#F5F6F4"
      },
      "package": "com.arkive.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/branding/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "O ArkIve usa o microfone para gravar a narrativa clínica ditada pelo veterinário e enviá-la para transcrição.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/branding/definitive.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F4",
          "dark": {
            "backgroundColor": "#0E0F11"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "O ArkIve usa a câmera para ler QR Codes de compartilhamento de pacientes.",
          "microphonePermission": false
        }
      ]
    ]
  }
}