# Optional. Overrides src/config/api.ts's default ArkIve Spring Boot API URL
# (https://arkive-b7v2.onrender.com). Useful for pointing a local build at a
# backend running on your LAN, e.g. http://192.168.15.14:8080.
#
# The base URL is not a secret — never put credentials here. There is no
# equivalent env var for username/password; those are entered at login and
# stored via expo-secure-store (see src/storage/credentialStore.ts).
EXPO_PUBLIC_API_URL=

# Optional. Overrides src/config/api.ts's default ArkIve web host
# (https://mobile-application-sooty.vercel.app) used only to build patient
# sharing invitation links (src/utils/shareLink.ts). Useful when testing
# sharing against a different deployed/local web build, e.g.
# http://localhost:8081. Not a secret, same rules as EXPO_PUBLIC_API_URL above.
EXPO_PUBLIC_SHARE_BASE_URL=
